{
  "name": "customer-intelligence-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "serve out",
    "typecheck": "tsc --noEmit",
